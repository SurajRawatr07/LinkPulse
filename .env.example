# ==============================================================================
# LinkPulse Production & Development Environment Configuration
# ==============================================================================

# MongoDB Connection (Required for Vercel deployment; fallback embedded MongoDB used in local AI Studio dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/linkpulse?retryWrites=true&w=majority

# Secret key for cryptographically signing authentication session tokens (HMAC-SHA256)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# Public short URL base domain (Defaults to https://linkpulse2026.vercel.app)
VITE_PUBLIC_SHORT_DOMAIN=https://linkpulse2026.vercel.app

# Node server port (3000 for Google AI Studio)
PORT=3000